VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- server-only: api/ serverless functions (never VITE_-prefixed, never
# bundled to the browser) -----------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

MTN_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox

# Disbursements = paying a seller out ("transfer") — escrow release and
# withdrawals. Collections (funding escrow, "request to pay") isn't wired
# up: that product wasn't available on the developer portal, so funding
# stays on the existing simulated flow for now.
MTN_DISBURSEMENTS_SUBSCRIPTION_KEY=
MTN_DISBURSEMENTS_API_USER=
MTN_DISBURSEMENTS_API_KEY=

# Only used when provisioning a sandbox API user (providerCallbackHost) —
# this integration polls for status client-side rather than relying on
# MTN calling back, so this doesn't need to be a live endpoint.
MTN_CALLBACK_HOST=https://your-deployment.vercel.app
